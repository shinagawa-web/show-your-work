proxy_cache_path /var/cache/nginx/pages keys_zone=pages:10m;

log_format cache '$msec "$request_uri" "$cookie_session" $status $upstream_cache_status "$upstream_addr"';

server {
    listen 80;
    access_log /results/access.log cache;

    location / {
        proxy_pass http://app:8080;
        proxy_cache pages;
        proxy_cache_valid 200 @CACHE_VALID@;
        @NGINX_EXTRA@
    }
}
