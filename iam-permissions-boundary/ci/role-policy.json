{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ManageVerificationRoles",
      "Effect": "Allow",
      "Action": [
        "iam:CreateRole",
        "iam:GetRole",
        "iam:DeleteRole",
        "iam:PutRolePolicy",
        "iam:GetRolePolicy",
        "iam:DeleteRolePolicy",
        "iam:ListRolePolicies",
        "iam:ListAttachedRolePolicies",
        "iam:DetachRolePolicy",
        "iam:ListInstanceProfilesForRole"
      ],
      "Resource": [
        "arn:aws:iam::*:role/syw-*",
        "arn:aws:iam::*:role/app/*"
      ]
    },
    {
      "Sid": "ManageBoundaryPolicy",
      "Effect": "Allow",
      "Action": [
        "iam:CreatePolicy",
        "iam:GetPolicy",
        "iam:DeletePolicy",
        "iam:ListPolicyVersions",
        "iam:DeletePolicyVersion"
      ],
      "Resource": "arn:aws:iam::*:policy/DevBoundary"
    },
    {
      "Sid": "AssumeVerificationRoles",
      "Effect": "Allow",
      "Action": "sts:AssumeRole",
      "Resource": [
        "arn:aws:iam::*:role/syw-*",
        "arn:aws:iam::*:role/app/*"
      ]
    },
    {
      "Sid": "FindLeftovers",
      "Effect": "Allow",
      "Action": "iam:ListRoles",
      "Resource": "*"
    }
  ]
}
