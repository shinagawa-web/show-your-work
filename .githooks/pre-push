#!/usr/bin/env bash
# Pushing to this public repository publishes the branch, so the check has to
# run before the push, not in CI. Enable with: git config core.hooksPath .githooks
set -euo pipefail
zero=0000000000000000000000000000000000000000
while read -r _ local_sha _ remote_sha; do
  [ "$local_sha" = "$zero" ] && continue
  if [ "$remote_sha" = "$zero" ]; then
    base=$(git merge-base origin/main "$local_sha")
  else
    base=$remote_sha
  fi
  "$(git rev-parse --show-toplevel)/scripts/check-public-refs.sh" "$base" "$local_sha"
done
