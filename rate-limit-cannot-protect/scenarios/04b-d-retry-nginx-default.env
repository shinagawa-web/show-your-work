# Hypothesis D with nginx defaults: nginx/d-retry-default.conf lists downstream:8081 three times
# with no max_fails / fail_timeout and no proxy_next_upstream lines; only proxy_read_timeout 200ms.
# /api/light 50 ms -> 250 ms at SWITCH_AT.
NGINX_CONF=d-retry-default.conf
ADMIN_QUERY=delay_light=250
