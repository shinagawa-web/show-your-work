# Hypothesis D from a load that fits without retries (nginx/d-retry-short.conf: retries as in
# d-retry.conf, proxy_read_timeout 60ms). /api/light 30 ms -> 80 ms at SWITCH_AT, limit 20.
# One attempt per request: 200 r/s x 0.08 s = 16 busy of 20 (capacity 250 r/s).
# Three attempts per request: 600 connections/s, over the 250 r/s capacity.
NGINX_CONF=d-retry-short.conf
INIT_QUERY=delay_light=30
ADMIN_QUERY=delay_light=80
