# Hypothesis E: per-tenant limit 50 r/s (nginx/e-tenant.conf). Each tenant sends 40 r/s on average to /api/light.
# Before SWITCH_AT: tenants t0-t2 (120 r/s). From SWITCH_AT: t0-t9 (400 r/s).
# The tenant of each request is picked at random (TENANT_PICK=random); arrivals are evenly spaced.
# /api/light = 60 ms, limit 20 -> capacity ~ 20 / 0.06 s = 333 r/s.
NGINX_CONF=e-tenant.conf
INIT_QUERY=delay_light=60
TENANT_MODE=1
TENANT_PICK=random
